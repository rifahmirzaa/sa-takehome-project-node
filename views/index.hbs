<div class="text-center mt-40">
  <h1>
    Stripe Press Shop
  </h1>
  <p class="text-secondary">
    Select an item to purchase
  </p>
</div>
<div class="mt-40 row">
  {{#each books}}
    <div class="col-12 col-md-4 mb-4">
      <div class="card box-shadow h-100">
        <img src="{{this.image}}" class="card-img-top" alt="Cover of {{this.title}}">
        <div class="card-body d-flex flex-column">
          <h5 class="card-title">{{this.title}}</h5>
          <strong>{{this.author}}</strong>
          <p class="card-text mt-20">
            {{this.description}}
          </p>
          <div class="mt-auto">
            <p class="card-text font-weight-bold text-secondary mb-2">
              Price: {{this.formattedPrice}} <span class="badge badge-light border">{{this.currencyDisplay}}</span>
            </p>
            <a href="/checkout?item={{this.id}}" class="btn btn-primary btn-block" aria-label="Select {{this.title}} — {{this.formattedPrice}} {{this.currencyDisplay}}">Select book — {{this.formattedPrice}}</a>
          </div>
        </div>
      </div>
    </div>
  {{/each}}
</div>
