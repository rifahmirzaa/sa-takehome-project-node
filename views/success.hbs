<div class="row justify-content-center">
  <div class="col-12 col-md-8 col-lg-6">
    <div class="card box-shadow mt-40">
      <div class="card-body p-4 text-center">
        <!-- Initial verification state -->
        <div id="status-loading">
          <div class="spinner-border text-primary my-3" role="status">
            <span class="sr-only">Checking payment…</span>
          </div>
          <h2 class="h4" id="status-loading-title">Checking payment…</h2>
          <p class="text-muted mb-0">Verifying transaction status with Stripe.</p>
        </div>

        <!-- Rendered verified result state -->
        <div id="status-result" class="d-none">
          <div id="status-icon" class="mb-3"></div>
          <h2 class="h4 mb-3" id="status-title"></h2>

          <div id="status-details" class="card bg-light border-0 mb-3 text-left d-none">
            <div class="card-body py-3">
              <div class="d-flex justify-content-between mb-2">
                <span class="text-muted">Total Paid:</span>
                <strong id="status-amount"></strong>
              </div>
              <div class="d-flex justify-content-between mb-2">
                <span class="text-muted">Currency:</span>
                <strong id="status-currency"></strong>
              </div>
              <div>
                <span class="text-muted d-block mb-1">Payment ID:</span>
                <code id="status-payment-id" class="text-break font-weight-bold d-block"></code>
              </div>
            </div>
          </div>

          <p id="status-message" class="text-muted mb-4"></p>
          <div id="status-actions"></div>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="/js/success.js"></script>